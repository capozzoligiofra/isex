# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase Dashboard -> Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Facoltativo: URL pubblico dell'app, usato nei link delle email di Supabase.
# Se assente viene ricavato dalla richiesta.
# NEXT_PUBLIC_SITE_URL=https://app.esempio.it
